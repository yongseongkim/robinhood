# Read by: uv run --env-file .env robinhood serve
# Production: existing main database, isolated service schema.
# Set credentials in your environment/secret manager, never commit a populated URL.
DATABASE_URL=
ROBINHOOD_DATABASE_SCHEMA=robinhood
# Optional direct connection for migrations, COPY and the session advisory lock.
# Needed when the API URL uses a transaction-pooled PgBouncer endpoint.
ROBINHOOD_JOB_DATABASE_URL=
ROBINHOOD_PSEUDONYMS=true
# NAVER Maps public application key ID; register http://localhost:5173 and your web URL.
# Never put the client secret here or in frontend code.
NAVER_MAPS_CLIENT_ID=
# Optional absolute paths (defaults point to this repository):
# ROBINHOOD_DATABASE=/path/to/robinhood-server/var/dashboard.sqlite3
# ROBINHOOD_DATA=/path/to/data/normalized
# ROBINHOOD_VAR=/path/to/robinhood-server/var
# ROBINHOOD_WEB_DIST=/path/to/robinhood-web/dist
# ROBINHOOD_COLLECTOR_PYTHON=/path/to/repository/.venv/bin/python

# Optional OCR text correction inside the server collection job.
# First install: uv sync --extra ocr-correction
# Uses a Codex ChatGPT login; does not fall back to an API key.
ROBINHOOD_OCR_CORRECTION_ENABLED=false
ROBINHOOD_OCR_MODEL=
ROBINHOOD_OCR_EFFORT=
# Dedicated Codex home, with its own config and an existing ChatGPT login.
# With systemd ProtectHome=true, use a service-readable location such as /var/lib/robinhood/codex-home.
ROBINHOOD_OCR_CODEX_HOME=
ROBINHOOD_OCR_MAX_BATCHES=5
ROBINHOOD_OCR_BATCH_ROWS=40
ROBINHOOD_OCR_TIMEOUT_SECONDS=120

[Unit]
Description=나랏일보고서 API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=robinhood
Group=robinhood
WorkingDirectory=/srv/robinhood
EnvironmentFile=/etc/robinhood/api.env
ExecStart=/srv/robinhood/robinhood-server/.venv/bin/robinhood serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target

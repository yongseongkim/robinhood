[Unit]
Description=나랏일보고서 API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=robin-hood
Group=robin-hood
WorkingDirectory=/srv/robin-hood
EnvironmentFile=/etc/robin-hood/api.env
ExecStart=/srv/robin-hood/robin-hood-server/.venv/bin/robin-hood serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target

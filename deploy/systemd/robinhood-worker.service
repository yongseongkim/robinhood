[Unit]
Description=나랏일보고서 periodic data collection
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=robinhood
Group=robinhood
WorkingDirectory=/srv/robinhood
EnvironmentFile=/etc/robinhood/worker.env
ExecStart=/srv/robinhood/robinhood-server/.venv/bin/robinhood worker --interval-hours 24
Restart=on-failure
RestartSec=30
# The worker finishes the current job on SIGTERM; child groups have a 2h timeout.
TimeoutStopSec=130min
KillMode=mixed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/robinhood/data /srv/robinhood/site/data /var/lib/robinhood
UMask=0077

[Install]
WantedBy=multi-user.target
